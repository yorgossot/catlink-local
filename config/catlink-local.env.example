# /etc/catlink-local/catlink-local.env -- configuration for both catlink-local services.
# Read by systemd (EnvironmentFile=): KEY=value lines, no shell expansion; quote a value that contains
# spaces (systemd strips the quotes).
# This file holds no secret (the Mosquitto password and the TLS key are separate root-only files).
# An empty value means "use the default". Flags take 0 or 1 only.
# A missing required value or a malformed one stops the service with exit code 2 and a message in the
# journal that names the variable.

# ---------------------------------------------------------------------------------------------------
# The box (both services)
# ---------------------------------------------------------------------------------------------------
# REQUIRED. The litter box's MAC address, six hex pairs: xx:xx:xx:xx:xx:xx (read it off your router).
# Only a peer with this MAC (looked up in the kernel ARP table) is served, and every frame must carry it.
CATLINK_BOX_MAC=

# Optional. The box's IP. If set, a peer must have this IP AND the MAC above; if empty, the MAC alone
# is checked (no DHCP reservation needed).
CATLINK_BOX_IP=

# REQUIRED. This host's LAN IP, the address your DNS redirects the box to. 0.0.0.0 is refused unless
# CATLINK_ALLOW_ANY_BIND=1.
CATLINK_BOX_BIND_IP=
CATLINK_ALLOW_ANY_BIND=0

# ---------------------------------------------------------------------------------------------------
# Gateway: the box-facing MQTT broker
# ---------------------------------------------------------------------------------------------------
CATLINK_BOX_BIND_PORT=1883

# ---------------------------------------------------------------------------------------------------
# Bootstrap responder (catlink-authresp)
# ---------------------------------------------------------------------------------------------------
# Default: CATLINK_BOX_BIND_IP. The box insists on port 443.
CATLINK_AUTH_BIND_IP=
CATLINK_AUTH_BIND_PORT=443
# Default: $CREDENTIALS_DIRECTORY/cert.pem and key.pem (the unit loads /etc/catlink-local/{cert,key}.pem
# with LoadCredential=). A plain path also works.
CATLINK_AUTH_CERT=
CATLINK_AUTH_KEY=
# The broker address handed to the box. Default: CATLINK_BOX_BIND_IP and CATLINK_BOX_BIND_PORT.
CATLINK_ADVERTISED_MQTT_HOST=
CATLINK_ADVERTISED_MQTT_PORT=

# ---------------------------------------------------------------------------------------------------
# Gateway: your Mosquitto (the Home Assistant side)
# ---------------------------------------------------------------------------------------------------
CATLINK_HA_HOST=127.0.0.1
CATLINK_HA_PORT=1883
CATLINK_HA_USER=catlink
# Default: $CREDENTIALS_DIRECTORY/ha_mqtt_pass (the unit loads /etc/catlink-local/ha_mqtt.pass).
# The password is read once and never logged.
CATLINK_HA_PASS_FILE=

# 1 enables the command half (buttons, switches, selects, numbers in Home Assistant). Read the safety
# notes in docs/DESIGN.md first. 0 = read-only sensors; nothing can ever be sent to the box.
CATLINK_COMMANDS=0

CATLINK_DISCOVERY_PREFIX=homeassistant
# State/command topic base: <BASE>/state, <BASE>/diag, <BASE>/visits, <BASE>/availability, <BASE>/<id>/set
CATLINK_BASE=catlink/litterbox
# Discovery node id and unique_id prefix.
CATLINK_NODE=catlink_litterbox
# Home Assistant device name; HA builds entity ids from it (e.g. button.catlink_open_x_clean_now).
CATLINK_DEVICE_NAME="CATLINK Open X"
CATLINK_DEVICE_ID=catlink_open_x

# ---------------------------------------------------------------------------------------------------
# Gateway: cat identification (optional, off by default)
# ---------------------------------------------------------------------------------------------------
# Empty = off. One or two cats as slug=kg, lighter cat first, e.g.  cat_a=3.20,cat_b=4.60
# Rules (a violation stops the gateway with exit code 2):
#   - slug: [a-z][a-z0-9_]*, unique; the slugs unknown, last_visit and last_deposit are reserved
#   - kg: between 0.2 and 12
#   - with two cats the lighter one comes first (its kg must be strictly smaller)
#   - at most 2 entries
# The slugs become entity ids (sensor.catlink_open_x_cat_a_weight) and command topics (set_ref_cat_a).
# The kg value is only a starting seed: it is used until cats.json exists (after the first visit or
# command). Changing it here later has no effect while the slugs stay the same. To re-seed, publish a
# weigh-in to <BASE>/set_ref_<slug>/set, or stop the gateway, delete cats.json, and start it again.
CATLINK_CATS=

# ---------------------------------------------------------------------------------------------------
# Gateway: state files
# ---------------------------------------------------------------------------------------------------
# Default: $STATE_DIRECTORY/visits.jsonl and cats.json (the unit sets StateDirectory=catlink-local,
# i.e. /var/lib/catlink-local/).
CATLINK_VISITS_FILE=
CATLINK_CATS_FILE=

# ---------------------------------------------------------------------------------------------------
# Logging and test switches (both services)
# ---------------------------------------------------------------------------------------------------
# 0 (default) = no cap: journald rotates the journal itself (SystemMaxUse= in journald.conf) and
# rate-limits bursts (RateLimitIntervalSec=/RateLimitBurst=; a suppressed burst shows as
# "Suppressed N messages" in the journal). A positive value caps the bytes each process logs since
# start (minimum 4096): one "log_cap_reached" line, then silence until restart.
CATLINK_LOG_MAX_BYTES=0
# Tests only: run the box broker + decoder without the Home Assistant client.
CATLINK_NO_HA=0
# Tests only: accept ANY peer (no MAC/IP pin). Logged loudly as peer_check_disabled. Never in production.
CATLINK_SKIP_PEER_CHECK=0
