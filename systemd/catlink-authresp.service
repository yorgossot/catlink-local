# catlink-local HTTPS bootstrap responder: answers the litter box's start-up login with the address of
# the local gateway. Never connects out. Installed by install.sh to /etc/systemd/system/.
# Configuration: /etc/catlink-local/catlink-local.env. The certificate and key are generated by you
# (see docs/SETUP.md); they are never shipped with this repository.
# Logs: journalctl -u catlink-authresp -o cat   (one JSON object per line)
[Unit]
Description=catlink-local HTTPS bootstrap responder (never connects out)
Documentation=https://github.com/yorgossot/catlink-local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/catlink-local/catlink-local.env
# systemd copies these root-only files into $CREDENTIALS_DIRECTORY for the service.
LoadCredential=cert.pem:/etc/catlink-local/cert.pem
LoadCredential=key.pem:/etc/catlink-local/key.pem
ExecStart=/usr/bin/python3 -I -u /opt/catlink-local/authresp.py
DynamicUser=yes
# The box insists on port 443: allow binding it without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET
MemoryMax=48M
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
